{
  "okf_version": "0.2",
  "description": "Prati profile of OKF v0.2. OKF requires only `type`; this profile adds self-description and provenance requirements.",
  "required_fields": [
    "type",
    "title",
    "description",
    "status",
    "generated",
    "sources"
  ],
  "status_values": [
    "draft",
    "stable",
    "deprecated"
  ],
  "types": {
    "Product": "product",
    "Architecture": "architecture",
    "Concept": "concepts",
    "Decision": "decisions",
    "Practice": "practices",
    "Technology": "technologies",
    "Runbook": "runbooks",
    "Term": "glossary"
  },
  "actor_pattern": "^(human:[a-z0-9._-]+|process:[a-z0-9._-]+|[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)$",
  "forbidden_text": [
    "docs/requirements/",
    "openspec/changes/",
    "openspec/specs/"
  ],
  "independence": "Concept links and sources may point only inside this bundle or to absolute external URLs. Knowledge never depends on requirements, specifications, changes, or implementation.",
  "required_sections": {
    "Decision": [
      "Context",
      "Decision",
      "Alternatives considered",
      "Consequences"
    ]
  },
  "forbidden_words": [
    "\\bthis change\\b",
    "\\bthis ticket\\b",
    "\\bthis sprint\\b",
    "\\bTODO:"
  ],
  "max_lines": 400
}
